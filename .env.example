# Copy this file to .env and fill in your key. Never upload .env to GitHub.

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=paste_your_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

AGENT_NAME=Agent
WAKE_WORD=hey agent
USER_NAME=Om

# Speech: en-IN understands Hinglish in English letters; hi-IN gives Devanagari
RECOGNITION_LANG=en-IN
VOICE_LANG=en-IN

# Your timezone (for Calendar and reminders)
TIMEZONE=Asia/Kolkata

# WhatsApp (Phase 3): 1 = hide the WhatsApp window after QR login
WA_HEADLESS=0

# Phone access on the same Wi-Fi: set a PIN, then start with run_phone.bat.
# Leave empty to keep the agent PC-only.
ACCESS_PIN=

# Online mode (run_online.bat): PIN must be at least 6 characters.
# Vercel pages allowed to call this PC (comma separated). Default is the my-agent-ui project.
# ALLOWED_ORIGINS=https://my-agent-ui-three.vercel.app
# UI_URL=https://my-agent-ui-three.vercel.app

# --- PC relay (lets your phone / the cloud app control this PC; see REAL_SETUP.md) ---
# Your cloud app address and the same PIN you set as ACCESS_PIN in Vercel.
CLOUD_URL=
CLOUD_PIN=

# --- Free multi-provider LLM router (recommended: keeps the agent working when one provider runs out of free quota) ---
# Your router address (ends with /v1) and its "Unified API key" (starts with freellmapi-).
LLM_ROUTER_URL=
LLM_ROUTER_KEY=

# --- Optional power features (see requirements-extra.txt) ---
# BROWSER_AGENT=1 lets the agent do multi-step shopping/booking research with browser-use. It stops before any order, payment or submit.
BROWSER_AGENT=0
# BROWSER_USE_MODEL=auto
# Extra sites browser_task may open (comma separated):
# BROWSER_AGENT_DOMAINS=
# Operate any Windows app (not only the browser) through Windows-MCP. Needs `uv`. Every click/type/shortcut asks you first;
# pay/send/submit buttons and password/card/OTP fields are refused in code.
WINDOWS_MCP=0
# Free offline Hindi voice (Kokoro). First use downloads ~120 MB into data/kokoro.
KOKORO_TTS=0
# Offline wake word instead of Chrome's cloud speech: WAKEWORD_ENGINE=openwakeword
# OWW_MODEL=hey_jarvis   (or the path to your own .onnx, e.g. a "hey agent" model you trained)
# OWW_THRESHOLD=0.6
WAKEWORD_ENGINE=
