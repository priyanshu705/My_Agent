# Copy this file to .env and fill in your key. Never upload .env to GitHub.

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=paste_your_key_here
GEMINI_MODEL=gemini-2.5-flash

AGENT_NAME=Agent
WAKE_WORD=hey agent
USER_NAME=Om

# Speech: en-IN understands Hinglish in English letters; hi-IN gives Devanagari
RECOGNITION_LANG=en-IN
VOICE_LANG=en-IN

# Your timezone (for Calendar and reminders)
TIMEZONE=Asia/Kolkata

# WhatsApp (Phase 3): 1 = hide the WhatsApp window after QR login
WA_HEADLESS=0

# Phone access on the same Wi-Fi: set a PIN, then start with run_phone.bat.
# Leave empty to keep the agent PC-only.
ACCESS_PIN=
